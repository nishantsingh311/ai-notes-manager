# Copy this file to .env.docker and set unique local credentials before starting.
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
BACKEND_FORWARD_PORT=8000

DB_DATABASE=ai_notes_manager
DB_USERNAME=ai_notes_user
DB_PASSWORD=change-this-local-db-password
DB_ROOT_PASSWORD=change-this-local-root-password
MYSQL_FORWARD_PORT=3307

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

FRONTEND_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=120

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_TIMEOUT=30
EMBEDDING_MIN_SIMILARITY=0.37
